# =====================================================================
# Our Lady of Joy - Homily Automation
# Copy this file to ".env" on the laptop and fill in the real values.
#   Copy-Item .env.example .env
# Never commit the real .env (it is in .gitignore).
# =====================================================================

# --- Church ---
CHURCH_NAME=Our Lady of Joy
# Homilist name is intentionally omitted - it changes week to week.
TIMEZONE=America/Phoenix

# --- FTP recorder (Denon DN-900R, local network only) ---
FTP_HOST=192.168.1.50
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/
FTP_TIMEOUT_SECONDS=30
# Recorder filename pattern, e.g. 09112026140100_DN-900R.mp3
# = MMDDYYYYHHMMSS_<recorder>.mp3  (start time of that chunk)
RECORDER_FILENAME_FORMAT=%m%d%Y%H%M%S
# Chunks from this recorder are 10 minutes. A larger gap between chunk
# start times starts a new service (multiple Masses on one Sunday).
CHUNK_MINUTES=10
SERVICE_GAP_MINUTES=20

# --- Local folders ---
# Base install/data folder. Leave blank to use the repo folder.
APP_BASE_DIR=
# Models live here (created by scripts\setup_windows.ps1).
MODELS_DIR=.\models
LOCAL_WORK_DIR=.\work
REVIEW_DIR=.\review
LOG_DIR=.\logs
STATE_FILE=.\data\state.json

# --- Publishing: Dropbox -> parish site ---
# YOU set this. Adding the finished blog post file to this folder makes
# it show up on the parish site, so writing here IS publishing.
# Windows example: C:\Users\YourName\Dropbox\Our Lady of Joy\Homilies
DROPBOX_HOMILY_DIR=
BLOG_FORMAT=md
BLOG_CATEGORY=Homilies

# --- Transcription (faster-whisper, CPU only on the target laptop) ---
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_PASS1_MODEL=small
WHISPER_PASS2_MODEL=medium
WHISPER_LANGUAGE=en
WHISPER_CPU_THREADS=10
# Audio gates - near-silent files go to REVIEW_DIR, never to Dropbox/Spotify.
MIN_MEAN_VOLUME_DB=-50
MIN_PEAK_VOLUME_DB=-30
# Homily detection confidence 0-1 required to auto-publish.
MIN_HOMILY_CONFIDENCE=0.60

# --- Local LLM (optional, Ollama - detection help + blog formatting) ---
# Processing stays local. Leave ENABLE_OLLAMA=false to use rules only.
ENABLE_OLLAMA=false
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# --- Spotify (podcast) ---
# READ docs/SPOTIFY.md first: Spotify has NO public API endpoint to upload
# an MP3 episode to an account. Episodes reach Spotify via a podcast RSS
# feed that a host serves and Spotify ingests. This pipeline therefore:
#   1. copies the homily MP3 to PODCAST_AUDIO_DIR (a publicly served folder)
#   2. regenerates PODCAST_FEED_FILE (feed.xml) with the new episode
# Submit that feed ONCE in Spotify for Podcasters; after that Spotify
# picks up new episodes automatically.
ENABLE_SPOTIFY=false
PODCAST_TITLE=Our Lady of Joy Homilies
PODCAST_DESCRIPTION=Weekly homilies from Our Lady of Joy.
PODCAST_AUTHOR=Our Lady of Joy
PODCAST_LANGUAGE=en-us
PODCAST_CATEGORY=Religion & Spirituality
PODCAST_SUBCATEGORY=Christianity
# Public base URL where PODCAST_AUDIO_DIR is served over HTTPS, e.g.
# https://www.ourladyofjoy.org/homilies/audio
# --- GitHub Pages preset (free host from this repo, see docs/GITHUB_PAGES.md):
# PODCAST_AUDIO_DIR=.\docs\audio
# PODCAST_FEED_FILE=.\docs\feed.xml
# PODCAST_AUDIO_BASE_URL=https://pivital-az.github.io/oloj-homily-automation/audio
# PODCAST_FEED_BASE_URL=https://pivital-az.github.io/oloj-homily-automation
PODCAST_AUDIO_BASE_URL=
PODCAST_FEED_BASE_URL=
PODCAST_AUDIO_DIR=
PODCAST_FEED_FILE=
PODCAST_ARTWORK_URL=
PODCAST_CONTACT_EMAIL=
# Optional, informational only (no upload is done with these):
SPOTIFY_SHOW_ID=
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
